// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`projectors > activity > is stable 1`] = `
"@startuml
title Circular analysis pipeline
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam ArrowColor #33475B
skinparam NoteBackgroundColor #FFF8E1
skinparam NoteBorderColor #E0C97F
skinparam ActivityBackgroundColor #F4F7FB
skinparam ActivityBorderColor #33475B

|Ingestion|
start
:Fetch new circulars;
:Parse into clause table;
if (Parsed successfully?) then (yes)
  |Analysis|
  :Extract obligations;
  fork
    :Run gap analysis;
  fork again
    :Assess IT and operational impact;
  end fork
  :Compile findings report;
  |Review|
  :Officer signs off;
  stop
else (no)
  :Quarantine for manual review;
  stop
endif

@enduml
"
`;

exports[`projectors > class > is stable 1`] = `
"@startuml
title SEBI Compliance Monitor — Domain Model
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam ArrowColor #33475B
skinparam NoteBackgroundColor #FFF8E1
skinparam NoteBorderColor #E0C97F
skinparam classAttributeIconSize 0
hide empty members

class "Circular" as circular {
  +id : string
  +reference : string
  +publishedAt : date
  +sourceUrl : string
}
class "Clause" as clause {
  +number : string
  +text : string
}
class "Obligation" as obligation {
  +summary : string
  +deadline : date
  +applicability : string
}
class "Control" as control {
  +name : string
  +owner : string  [PII]
}
class "Gap" as gap {
  +severity : string
  +rationale : string
}
class "ImpactAssessment" as impact {
  +itEffortDays : int
  +opsEffortDays : int
}

circular "1" -- "*" clause : contains
clause "1" -- "*" obligation : yields
obligation "1" -- "*" gap : assessed by
gap "1" -- "1" control : against
impact "1" -- "1" obligation : for

legend right
  [PII] marks personally identifiable or regulated fields
end legend

@enduml
"
`;

exports[`projectors > communication > is stable 1`] = `
"@startuml
title Nightly circular ingestion and analysis — Communication
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam ArrowColor #33475B
skinparam NoteBackgroundColor #FFF8E1
skinparam NoteBorderColor #E0C97F

actor "Nightly Scheduler" as nightly_scheduler
participant "Circular Fetcher" as circular_fetcher
actor "SEBI Portal" as sebi_portal
participant "Ingestion Queue" as ingest_queue
participant "Clause Parser" as clause_parser
participant "Requirement Extractor" as requirement_extractor
participant "Gap Analyser" as gap_analyser
participant "Compliance Store" as compliance_db
actor "Compliance Officer" as compliance_officer

nightly_scheduler -> circular_fetcher : 1: run ingestion
circular_fetcher -> sebi_portal : 2: GET /circulars?since=lastRun
sebi_portal --> circular_fetcher : 3: circular list + PDFs
circular_fetcher -> ingest_queue : 4: enqueue circular
ingest_queue -> clause_parser : 5: deliver circular
clause_parser -> compliance_db : 6: save clause table
clause_parser -> requirement_extractor : 7: extract obligations
requirement_extractor -> gap_analyser : 8: analyse gaps
gap_analyser -> compliance_db : 9: save findings
gap_analyser -> compliance_officer : 10: notify: findings ready for review

@enduml
"
`;

exports[`projectors > component > is stable 1`] = `
"@startuml
title SEBI Compliance Monitor — Components
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam ArrowColor #33475B
skinparam NoteBackgroundColor #FFF8E1
skinparam NoteBorderColor #E0C97F
left to right direction
skinparam componentStyle rectangle
skinparam nodesep 30
skinparam ranksep 90
skinparam packageStyle rectangle

package "Ingestion" as pkg_ingest {
  [Circular Fetcher] as circular_fetcher <<job>>
  interface "ICircularSource" as ifetch
  circular_fetcher -- ifetch
  [Clause Parser] as clause_parser <<service>>
  interface "IClauseTable" as iparse
  clause_parser -- iparse
}

package "Analysis" as pkg_analysis {
  [Requirement Extractor] as requirement_extractor <<service>>
  interface "IObligations" as iextract
  requirement_extractor -- iextract
  [Gap Analyser] as gap_analyser <<service>>
  interface "IGapAnalysis" as igap
  gap_analyser -- igap
  [Impact Assessor] as impact_assessor <<service>>
  interface "IImpactAssessment" as iimpact
  impact_assessor -- iimpact
}

package "Platform" as pkg_platform {
  [Compliance Store] as compliance_db <<db>>
  interface "IComplianceStore" as istore
  compliance_db -- istore
  [Review Console] as review_ui <<ui>>
  [Ingestion Queue] as ingest_queue <<queue>>
}

[Control Library] as control_library <<external>>
interface "IControlLibrary" as icontrols
control_library -- icontrols

clause_parser ..> ifetch : uses
requirement_extractor ..> iparse : uses
gap_analyser ..> iextract : uses
gap_analyser ..> icontrols : uses
impact_assessor ..> iextract : uses
review_ui ..> igap : uses
review_ui ..> iimpact : uses

@enduml
"
`;

exports[`projectors > composite-structure > is stable 1`] = `
"@startuml
title Clause Parser — Internal Structure
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam ArrowColor #33475B
skinparam NoteBackgroundColor #FFF8E1
skinparam NoteBorderColor #E0C97F

component "Clause Parser" as clause_parser {
  portin "ICircularSource" as in_ifetch
  portout "IClauseTable" as out_iparse
  component "Segment circulars into clauses" as clause_parser_p0
  component "Normalise clause numbering" as clause_parser_p1
  component "Emit a clause table" as clause_parser_p2

  in_ifetch --> clause_parser_p0
  clause_parser_p0 --> clause_parser_p1
  clause_parser_p1 --> clause_parser_p2
  clause_parser_p2 --> out_iparse
}

@enduml
"
`;

exports[`projectors > deployment > is stable 1`] = `
"@startuml
title SEBI Compliance Monitor — Deployment
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam ArrowColor #33475B
skinparam NoteBackgroundColor #FFF8E1
skinparam NoteBorderColor #E0C97F

node "ECS Fargate Cluster" as n_ecs <<production>> {
  artifact "ingest-service.jar\\n(Circular Fetcher, Clause Parser)" as art_ingest
  artifact "analysis-service.jar\\n(Requirement Extractor, Gap Analyser, Impact A…)" as art_analysis
}
cloud "MongoDB Atlas" as n_atlas <<ap-south-1>> {
  artifact "compliance-db\\n(Compliance Store)" as art_db
}
cloud "S3 Document Bucket" as n_s3 <<ap-south-1>>
node "Officer Workstation" as n_workstation <<corporate LAN>> {
  artifact "review-console.bundle\\n(Review Console)" as art_ui
}

n_workstation --> n_ecs

@enduml
"
`;

