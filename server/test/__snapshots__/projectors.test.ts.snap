exports[`projectors > profile > is stable 1`] = `
"@startuml
title SEBI Compliance Monitor — UML Profile
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam ArrowColor #33475B
skinparam NoteBackgroundColor #FFF8E1
skinparam NoteBorderColor #E0C97F

package "SEBI Compliance Monitor Profile" <<Frame>> {
  class Component <<metaclass>>
  class Class <<metaclass>>

  class Job <<stereotype>>
  Job -up-|> Component
  class Service <<stereotype>>
  Service -up-|> Component
  class External <<stereotype>>
  External -up-|> Component
  class Db <<stereotype>>
  Db -up-|> Component
  class Ui <<stereotype>>
  Ui -up-|> Component
  class Queue <<stereotype>>
  Queue -up-|> Component

  class Pii <<stereotype>> {
    +lawfulBasis : string
    +retentionDays : int
  }
  Pii -up-|> Class

  class auditability <<stereotype>>
  auditability -up-|> Component
  class security <<stereotype>>
  security -up-|> Component
  class availability <<stereotype>>
  availability -up-|> Component
  class performance <<stereotype>>
  performance -up-|> Component
}

legend right
  **Constraints**
  auditability: Every finding must trace back to a specific clause and circular…
  security: Control owner identities are PII and must be access-controlled
  availability: A failed nightly run must retry before 08:00 IST
  performance: A single circular must complete analysis within 10 seconds
end legend

@enduml
"
`;

exports[`projectors > sequence > is stable 1`] = `
"@startuml
title Nightly circular ingestion and analysis
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam ArrowColor #33475B
skinparam NoteBackgroundColor #FFF8E1
skinparam NoteBorderColor #E0C97F
skinparam sequenceMessageAlign center
skinparam maxMessageSize 220
autonumber

actor "Nightly Scheduler" as nightly_scheduler
control "Circular Fetcher" as circular_fetcher
actor "SEBI Portal" as sebi_portal
queue "Ingestion Queue" as ingest_queue
participant "Clause Parser" as clause_parser
participant "Requirement Extractor" as requirement_extractor
participant "Gap Analyser" as gap_analyser
database "Compliance Store" as compliance_db
actor "Compliance Officer" as compliance_officer

note over nightly_scheduler : Trigger: Nightly schedule at 02:00 IST

nightly_scheduler -> circular_fetcher : run ingestion
circular_fetcher -> sebi_portal : GET /circulars?since=lastRun
sebi_portal --> circular_fetcher : circular list + PDFs
loop for each new circular
circular_fetcher ->> ingest_queue : enqueue circular
ingest_queue ->> clause_parser : deliver circular
end
clause_parser -> compliance_db : save clause table
clause_parser -> requirement_extractor : extract obligations
alt obligations found
requirement_extractor -> gap_analyser : analyse gaps
gap_analyser -> compliance_db : save findings
end
gap_analyser ->> compliance_officer : notify: findings ready for review

group Error handling
note over circular_fetcher : SEBI portal unreachable → retry with backoff, alert on 3rd failure
note over clause_parser : PDF fails to parse → quarantine circular for manual review
end

@enduml
"
`;

exports[`projectors > state-machine > is stable 1`] = `
"@startuml
title Circular — Lifecycle
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam ArrowColor #33475B
skinparam NoteBackgroundColor #FFF8E1
skinparam NoteBorderColor #E0C97F

state "Discovered" as s_discovered
state "Parsed" as s_parsed
state "Analysed" as s_analysed
state "Quarantined" as s_quarantined
state "Signed off" as s_signed_off

[*] --> s_discovered : published by SEBI
s_discovered --> s_parsed : parse [PDF readable] / build clause table
s_discovered --> s_quarantined : parse [PDF unreadable] / notify operations
s_parsed --> s_analysed : analyse / run gap and impact
s_quarantined --> s_parsed : manual fix
s_analysed --> s_signed_off : officer approves
s_signed_off --> [*] : archive

s_discovered : entry / record source URL
s_parsed : entry / index clause table
s_analysed : entry / attach gap and impact findings
s_quarantined : entry / raise manual-review task
s_signed_off : entry / stamp reviewer and timestamp

@enduml
"
`;

exports[`projectors > timing > is stable 1`] = `
"@startuml
title SEBI Compliance Monitor — Timing & SLAs
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam ArrowColor #33475B
skinparam NoteBackgroundColor #FFF8E1
skinparam NoteBorderColor #E0C97F

robust "Circular" as circular

@0
circular is Discovered
@900
circular is Parsed
@4000
circular is Analysed
@30000
circular is Reported

legend right
  Ingest to parsed: 2000 ms
  Parsed to analysed: 10000 ms
  End-to-end nightly run: 1800000 ms
end legend

@enduml
"
`;

exports[`projectors > use-case > is stable 1`] = `
"@startuml
title SEBI Compliance Monitor — Use Cases
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam ArrowColor #33475B
skinparam NoteBackgroundColor #FFF8E1
skinparam NoteBorderColor #E0C97F
left to right direction

actor "Compliance Officer" as compliance_officer
actor "SEBI Portal" as sebi_portal
actor "Nightly Scheduler" as nightly_scheduler

rectangle "SEBI Compliance Monitor" {
  usecase "Ingest latest circulars" as uc_ingest
  usecase "Review new obligations" as uc_review
  usecase "Run gap analysis" as uc_gap
  usecase "Assess IT and operational impact" as uc_impact
}

nightly_scheduler --> uc_ingest
sebi_portal --> uc_ingest
compliance_officer --> uc_review
compliance_officer --> uc_gap
compliance_officer --> uc_impact
uc_review ..> uc_gap : <<include>>
uc_impact ..> uc_gap : <<extend>>

@enduml
"
`;
