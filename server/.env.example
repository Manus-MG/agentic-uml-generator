# --- server -----------------------------------------------------------------
PORT=5001
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/umlgenerator

# --- Groq -------------------------------------------------------------------
# Never commit a real key. Get one at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here
# Strict json_schema (constrained decoding) is only supported on the gpt-oss
# models. Point MODEL_PRIMARY at anything else and structured output silently
# degrades to best-effort JSON.
MODEL_PRIMARY=openai/gpt-oss-120b
MODEL_FAST=openai/gpt-oss-20b
LLM_CONCURRENCY=4
LLM_MAX_RETRIES=4

# --- PlantUML ---------------------------------------------------------------
# jar    : local plantuml.jar via `java` (run `npm run fetch:plantuml` first)
# server : a running plantuml/plantuml-server container
PLANTUML_BACKEND=jar
PLANTUML_JAR=vendor/plantuml.jar
PLANTUML_SERVER_URL=http://localhost:8080
JAVA_BIN=java
JAVA_MAX_HEAP=512m
PLANTUML_TIMEOUT_MS=30000

# --- generation -------------------------------------------------------------
OUTPUT_DIR=output
DIAGRAM_CONCURRENCY=4
# projector : deterministic TypeScript CSM -> PlantUML (default, recommended)
# llm       : ask the model to write PlantUML directly (experimental)
DIAGRAM_STRATEGY=projector
MAX_REPAIR_ATTEMPTS=2
MAX_CSM_REPAIR_ATTEMPTS=2
